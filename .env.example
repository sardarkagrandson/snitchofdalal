# This file is the OPERATOR DEFAULTS for every installation and is shipped with the app.
# Values here apply to all users; each machine can override any line in its own .env
# (created automatically by the start script). Keep the repository private if you put
# credentials here.

# ---- Application ----
APP_NAME=SnitchofDalal
# Where SQLite databases live (relative to project root)
DATA_DIR=data
# Set true to run with deterministic synthetic prices/news (no network needed)
OFFLINE_MODE=false
# Market shown by default: IN (India, NSE/BSE) or ZA (South Africa, JSE). Users can switch in the header.
DEFAULT_MARKET=IN
# Extra JSE holidays (YYYY-MM-DD, comma-separated); South African public holidays for 2026-27 are built in.
MARKET_HOLIDAYS_ZA=
# Extra NSE trading holidays (YYYY-MM-DD, comma-separated). The official NSE list is
# fetched automatically once a day; use this only to add dates.
MARKET_HOLIDAYS=
# Price source: auto = official NSE quotes with Yahoo Finance fallback | yfinance = Yahoo only
QUOTE_SOURCE=auto
# Network interface for the Docker port. 127.0.0.1 = this computer only (default); 0.0.0.0 = whole LAN
BIND_HOST=127.0.0.1
APP_PORT=8000

# Public grey-market-premium pages parsed for IPO GMP (unofficial), tried in order. Empty disables.
IPO_GMP_URL=https://www.investorgain.com/report/live-ipo-gmp/331/,https://ipowatch.in/ipo-grey-market-premium-latest-ipo-gmp/

# ---- Device licensing ----
# Leave empty for open access. To restrict the app to approved devices, run
#   python tools/license_admin.py keygen
# and paste the printed public key here before distributing. Each device then shows a
# Device ID on first launch; issue it a key with `tools/license_admin.py issue`.
LICENSE_PUBLIC_KEY=

# ---- LLM sentiment (optional; heuristic classifier is used when unset) ----
ANTHROPIC_API_KEY=
SENTIMENT_MODEL=claude-opus-5-5

# ---- Email alerts (optional; alerts are written to data/outbox when unset) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
#        SMTP_PASSWORD=<16-character App Password from myaccount.google.com/apppasswords>,
#        SMTP_FROM=you@gmail.com. Port 465 (implicit TLS) is also supported.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=snitchondalal@gmail.com
SMTP_PASSWORD=grgndxnilblkyyhx
SMTP_FROM=snitchondalal@gmail.com

# ---- Caching ----
QUOTE_CACHE_SECONDS=60
# How often an open stock page refreshes its price during market hours (seconds). 3 is the
# practical floor for NSE's public quote endpoint; 2 may work but risks NSE blocking the client.
# Yahoo-sourced prices (JSE, NSE fallback) poll no faster than every 10 s because the feed is delayed.
LIVE_QUOTE_SECONDS=3
HISTORY_CACHE_SECONDS=900
NEWS_CACHE_SECONDS=1800
SMTP_PREFER_IPV4=true
SMTP_TIMEOUT_SECONDS=25
